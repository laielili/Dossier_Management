<deck project="[PROJECT_NAME]" theme="loreal">
  <!-- ===== top_banner (repeated on every page) ===== -->
  <component type="title">
    <svg viewBox="0 0 1000 22" width="1000" height="22">
      <text x="0" y="18" font-size="18" font-weight="bold" fill="#333">[PROJECT_NAME]</text>
    </svg>
  </component>
  <component type="formula-ref">
    <svg viewBox="0 0 1000 14" width="1000" height="14">
      <text x="0" y="11" font-size="11" fill="#c8860d">[FORMULA_REF]</text>
    </svg>
  </component>
  <!-- ===== left_column: all project metadata (viewBox 200 wide, font 10) ===== -->
  <component type="meta" label="Type">
    <svg viewBox="0 0 200 20" width="200" height="20">
      <text x="8" y="12" font-size="10" fill="#333">[PROJECT_TYPE]</text>
    </svg>
  </component>
  <component type="meta" label="Audience">
    <svg viewBox="0 0 200 20" width="200" height="20">
      <text x="8" y="12" font-size="10" fill="#333">[TARGET_AUDIENCE_LINE_1]</text>
    </svg>
  </component>
  <component type="meta" label="Communication">
    <svg viewBox="0 0 200 75" width="200" height="75">
      <text x="8" y="12" font-size="10" fill="#333">• [CLAIM_1]</text>
      <text x="8" y="27" font-size="10" fill="#333">• [CLAIM_2]</text>
      <text x="8" y="42" font-size="10" fill="#333">• [CLAIM_3]</text>
      <text x="8" y="57" font-size="10" fill="#333">• [CLAIM_4]</text>
    </svg>
  </component>
  <component type="info-card" label="Formulation">
    <svg viewBox="0 0 200 36" width="200" height="36">
      <text x="8" y="12" font-size="10" fill="#333">[FORMULATION_DETAIL_1]</text>
      <text x="8" y="27" font-size="10" fill="#333">[FORMULATION_DETAIL_2]</text>
    </svg>
  </component>
  <component type="info-card" label="Fragrance">
    <svg viewBox="0 0 200 36" width="200" height="36">
      <text x="8" y="12" font-size="10" fill="#333">N/A</text>
    </svg>
  </component>
  <component type="info-card" label="Packaging">
    <svg viewBox="0 0 200 36" width="200" height="36">
      <text x="8" y="12" font-size="10" fill="#333">[PACKAGING_SIZE]</text>
    </svg>
  </component>
  <component type="info-card" label="Sustainability">
    <svg viewBox="0 0 200 36" width="200" height="36">
      <text x="8" y="12" font-size="10" fill="#333">N/A</text>
    </svg>
  </component>
  <component type="info-card" label="Safety">
    <svg viewBox="0 0 200 36" width="200" height="36">
      <text x="8" y="12" font-size="10" fill="#333">[SAFETY_CLAIM]</text>
    </svg>
  </component>

  <!-- ===== summary-block: single-column PERFORMANCE SUMMARY band in banner right zone (viewBox 760x88) ===== -->
  <component type="summary-block">
    <svg viewBox="0 0 760 88" width="760" height="88" font-family="Arial, sans-serif">
      <!-- PERFORMANCE SUMMARY: project-subject synthesis; spine: project subject -> evidence & testing -> results & takeaway -->
      <text x="4" y="12" font-size="9" font-weight="bold" fill="#333">PERFORMANCE SUMMARY:</text>
      <text x="4" y="25" font-size="8.5" fill="#333">[PROJECT_SUBJECT_LINE]</text>
      <text x="4" y="38" font-size="8.5" fill="#333">[EVIDENCE_TESTING_LINE]</text>
      <text x="4" y="51" font-size="8.5" fill="#333">[RESULTS_METRIC_LINE_1]</text>
      <text x="4" y="64" font-size="8.5" fill="#333">[RESULTS_METRIC_LINE_2]</text>
      <text x="4" y="77" font-size="8.5" fill="#333">[TAKEAWAY_STAGE_LINE]</text>
    </svg>
  </component>

  <!-- ===== core_content: evidence area (viewBox 1000 wide) ===== -->
  <component type="efficacy-table">
    <svg viewBox="0 0 1000 160" width="1000" height="160">
      <rect x="0" y="0" width="1000" height="30" fill="#f5f5f5" />
      <text x="15" y="20" font-size="14" font-weight="bold" fill="#333">[STUDY_TITLE_1] [cn]</text>
      <text x="15" y="45" font-size="10" fill="#666">[STUDY_DESCRIPTION_1]</text>
      <line x1="0" y1="60" x2="1000" y2="60" stroke="#ddd" stroke-width="1" />
      <text x="15" y="80" font-size="12" fill="#333">[MEASURE_1]</text>
      <text x="560" y="80" font-size="12" font-weight="bold" fill="#2e7d32">T4W: [XX.XX%]</text>
      <text x="780" y="80" font-size="12" font-weight="bold" fill="#2e7d32">T8W: [XX.XX%]</text>
      <line x1="0" y1="95" x2="1000" y2="95" stroke="#eee" stroke-width="1" />
      <text x="15" y="115" font-size="12" fill="#333">[MEASURE_2]</text>
      <text x="560" y="115" font-size="12" font-weight="bold" fill="#2e7d32">T4W: [XX.XX%]</text>
      <text x="780" y="115" font-size="12" font-weight="bold" fill="#2e7d32">T8W: [XX.XX%]</text>
      <line x1="0" y1="130" x2="1000" y2="130" stroke="#eee" stroke-width="1" />
      <text x="15" y="150" font-size="12" fill="#333">[MEASURE_3]</text>
      <text x="560" y="150" font-size="12" font-weight="bold" fill="#2e7d32">T4W: [XX.XX%]</text>
      <text x="780" y="150" font-size="12" font-weight="bold" fill="#2e7d32">T8W: [XX.XX%]</text>
    </svg>
  </component>
  <component type="efficacy-table">
    <svg viewBox="0 0 1000 120" width="1000" height="120">
      <rect x="0" y="0" width="1000" height="30" fill="#f5f5f5" />
      <text x="15" y="20" font-size="14" font-weight="bold" fill="#333">[STUDY_TITLE_2] [us]</text>
      <text x="15" y="45" font-size="10" fill="#666">[N=XX] [STUDY_DESCRIPTION_2]</text>
      <line x1="0" y1="60" x2="1000" y2="60" stroke="#ddd" stroke-width="1" />
      <text x="15" y="80" font-size="12" fill="#333">[MEASURE_4]</text>
      <text x="560" y="80" font-size="12" font-weight="bold" fill="#2e7d32">T1W: [XX.XX%]</text>
      <text x="780" y="80" font-size="12" font-weight="bold" fill="#2e7d32">T12W: [XX.XX%]</text>
      <line x1="0" y1="95" x2="1000" y2="95" stroke="#eee" stroke-width="1" />
      <text x="15" y="115" font-size="12" fill="#333">[MEASURE_5]</text>
      <text x="560" y="115" font-size="12" font-weight="bold" fill="#2e7d32">T1W: [XX.XX%]</text>
      <text x="780" y="115" font-size="12" font-weight="bold" fill="#2e7d32">T12W: [XX.XX%]</text>
    </svg>
  </component>
  <component type="efficacy-table">
    <svg viewBox="0 0 1000 90" width="1000" height="90">
      <rect x="0" y="0" width="1000" height="30" fill="#f5f5f5" />
      <text x="15" y="20" font-size="14" font-weight="bold" fill="#333">[STUDY_TITLE_3] [br]</text>
      <text x="15" y="45" font-size="10" fill="#666">[N=XX] [STUDY_DESCRIPTION_3]</text>
      <line x1="0" y1="60" x2="1000" y2="60" stroke="#ddd" stroke-width="1" />
      <text x="15" y="80" font-size="12" fill="#333">[MEASURE_6]</text>
      <text x="560" y="80" font-size="12" font-weight="bold" fill="#2e7d32">T1Wk: [XX.X%]</text>
      <text x="780" y="80" font-size="12" font-weight="bold" fill="#2e7d32">T12Wk: [XX.X%]</text>
    </svg>
  </component>
  <component type="efficacy-table">
    <svg viewBox="0 0 1000 90" width="1000" height="90">
      <rect x="0" y="0" width="1000" height="30" fill="#f5f5f5" />
      <text x="15" y="20" font-size="14" font-weight="bold" fill="#333">[STUDY_TITLE_4] [fr]</text>
      <text x="15" y="45" font-size="10" fill="#666">[N=XX] [STUDY_DESCRIPTION_4]</text>
      <line x1="0" y1="60" x2="1000" y2="60" stroke="#ddd" stroke-width="1" />
      <text x="15" y="80" font-size="12" fill="#333">[MEASURE_7]</text>
      <text x="560" y="80" font-size="12" font-weight="bold" fill="#2e7d32">T4W: [XX.XX%]</text>
      <text x="780" y="80" font-size="12" font-weight="bold" fill="#2e7d32">T12W: [XX.XX%]</text>
    </svg>
  </component>
  <component type="efficacy-table">
    <svg viewBox="0 0 1000 90" width="1000" height="90">
      <rect x="0" y="0" width="1000" height="30" fill="#f5f5f5" />
      <text x="15" y="20" font-size="14" font-weight="bold" fill="#333">[STUDY_TITLE_5] [jp]</text>
      <text x="15" y="45" font-size="10" fill="#666">[N=XX] [STUDY_DESCRIPTION_5]</text>
      <line x1="0" y1="60" x2="1000" y2="60" stroke="#ddd" stroke-width="1" />
      <text x="15" y="80" font-size="12" fill="#333">[MEASURE_8]</text>
      <text x="560" y="80" font-size="12" font-weight="bold" fill="#2e7d32">T1h: +[XXX.XX%]</text>
      <text x="780" y="80" font-size="12" font-weight="bold" fill="#2e7d32">T24h: +[XX.XX%]</text>
    </svg>
  </component>
  <component type="consumer-block">
    <svg viewBox="0 0 1000 130" width="1000" height="130">
      <rect x="0" y="0" width="1000" height="30" fill="#e3f2fd" />
      <text x="15" y="20" font-size="14" font-weight="bold" fill="#1565c0">[CONSUMER_STUDY_TITLE_1] [gb]</text>
      <text x="15" y="45" font-size="10" fill="#666">[N=XX] [STUDY_DESCRIPTION_6]</text>
      <text x="15" y="70" font-size="12" fill="#333">• [PERCEPTION_1]</text>
      <text x="670" y="70" font-size="12" font-weight="bold" fill="#2e7d32">T12W: [XX.X%]</text>
      <text x="15" y="95" font-size="12" fill="#333">• [PERCEPTION_2]</text>
      <text x="670" y="95" font-size="12" font-weight="bold" fill="#2e7d32">T12W: [XX.X%]</text>
      <text x="15" y="120" font-size="12" fill="#333">• [PERCEPTION_3]</text>
      <text x="670" y="120" font-size="12" font-weight="bold" fill="#2e7d32">T12W: [XX.X%]</text>
    </svg>
  </component>
  <component type="consumer-block">
    <svg viewBox="0 0 1000 130" width="1000" height="130">
      <rect x="0" y="0" width="1000" height="30" fill="#e3f2fd" />
      <text x="15" y="20" font-size="14" font-weight="bold" fill="#1565c0">[CONSUMER_STUDY_TITLE_2] [in]</text>
      <text x="15" y="45" font-size="10" fill="#666">[N=XX] [STUDY_DESCRIPTION_7]</text>
      <text x="15" y="70" font-size="12" fill="#333">• [PERCEPTION_4]</text>
      <text x="670" y="70" font-size="12" font-weight="bold" fill="#333333">[TIMEPOINT_1]: [XX.X%]</text>
      <text x="15" y="95" font-size="12" fill="#333">• [PERCEPTION_5]</text>
      <text x="670" y="95" font-size="12" font-weight="bold" fill="#2e7d32">[TIMEPOINT_2]: [XX.X%]</text>
      <text x="15" y="120" font-size="12" fill="#333">• [PERCEPTION_6]</text>
      <text x="670" y="120" font-size="12" font-weight="bold" fill="#333333">[TIMEPOINT_1]: [XX.X%]</text>
    </svg>
  </component>
</deck>
