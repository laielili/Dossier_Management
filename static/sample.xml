<deck project="[PROJECT_NAME]" theme="loreal">
  <component type="title">
    <svg viewBox="0 0 1000 22" width="1000" height="22">
      <text x="0" y="18" font-size="18" font-weight="bold" fill="#333">[PROJECT_NAME]</text>
    </svg>
  </component>
  <component type="formula-ref">
    <svg viewBox="0 0 1000 14" width="1000" height="14">
      <text x="0" y="11" font-size="11" fill="#c8860d">[FORMULA_REF]</text>
    </svg>
  </component>
  <component type="description">
    <svg viewBox="0 0 440 20" width="440" height="20">
      <text x="12" y="14" font-size="8" fill="#333">[PRODUCT_DESCRIPTION]</text>
    </svg>
  </component>
  <component type="meta">
    <svg viewBox="0 0 1000 16" width="1000" height="16">
      <text x="0" y="12" font-size="8" fill="#333">
        <tspan font-weight="bold">Project Type: </tspan>[PROJECT_TYPE]
        <tspan font-weight="bold"> | Audience: </tspan>[TARGET_AUDIENCE]
      </text>
    </svg>
  </component>
  <component type="meta" region="right_column" label="Communication">
    <svg viewBox="0 0 380 60" width="380" height="60">
      <text x="12" y="16" font-size="12" fill="#333">• [CLAIM_1]</text>
      <text x="12" y="36" font-size="12" fill="#333">• [CLAIM_2]</text>
    </svg>
  </component>
  <component type="info-card" label="Formulation">
    <svg viewBox="0 0 380 50" width="380" height="50">
      <text x="12" y="20" font-size="11" fill="#333">[FORMULATION_DETAIL_1]</text>
      <text x="12" y="38" font-size="11" fill="#333">[FORMULATION_DETAIL_2]</text>
    </svg>
  </component>
  <component type="info-card" label="Fragrance">
    <svg viewBox="0 0 380 50" width="380" height="50">
      <text x="12" y="28" font-size="11" fill="#333">N/A</text>
    </svg>
  </component>
  <component type="info-card" label="Packaging">
    <svg viewBox="0 0 380 50" width="380" height="50">
      <text x="12" y="28" font-size="11" fill="#333">[PACKAGING_SIZE]</text>
    </svg>
  </component>
  <component type="info-card" label="Sustainability">
    <svg viewBox="0 0 380 50" width="380" height="50">
      <text x="12" y="28" font-size="11" fill="#333">N/A</text>
    </svg>
  </component>
  <component type="info-card" label="Safety">
