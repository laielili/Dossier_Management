# Dossier_Management
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# ---------- Vendored html-to-pptx ----------
# The `dist/` rule above would swallow the vendored converter bundle, which is
# the ONLY runtime artifact the HTML → PPTX page needs (it is loaded by the
# browser from /html-to-pptx/dist/...). It must be committed.
!html-to-pptx/dist/
!html-to-pptx/dist/html-to-pptx.min.js
html-to-pptx/node_modules/

# ---------- Auto-generated runtime data (do not commit) ----------
chroma_projects/
screenshots/
output/
retrieved/
logs/

# ---------- Per-project dossier folders (new model) ----------
# Each user project lives at the repo root as PROJECT_ROOT/<project_name>/
# and is auto-classified into <project_name>/{CLINS,FE,CE}/.
# The classified report subfolders (and their PDFs/pptx/docx) are user
# data and must NOT enter version control.
**/CLINS/
**/FE/
**/CE/

# ---------- Legacy data/ layout (kept for backward compatibility) ----------
data/
data/**/*.pdf

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Env ----------
.env
.env.local

# ---------- Runtime index (auto-generated) ----------
index_projects/

# ---------- Archive / trash ----------
_trash/

# ---------- WorkBuddy local workspace memory (not for VCS) ----------
.workbuddy/

# ---------- User-configured path configs (machine-specific) ----------
listen_folder.txt
search_paths.txt

# ---------- Local reports / presentation materials ----------
汇报/

#Demo
demo/

#Local saved search_paths
config_overrides.json