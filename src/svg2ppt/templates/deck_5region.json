{
  "name": "deck_4region",
  "description": "L'Oreal synthesis deck layout derived from prompt/system.md (SUMMARIZE section). Canvas 1000x562.5 (16:9). Regions: top_banner (project identity + Performance Summary card in its right zone, repeated on every page) / left_column (all project metadata) / core_content (evidence area, same geometry on every page). The standalone summary_band region was folded into the banner's right zone (summary_left_x aligned with the evidence area's left edge).",
  "canvas": {
    "width": 1000,
    "height": 562.5,
    "units": "px",
    "dpi": 150,
    "slide_aspect": "16:9"
  },
  "theme": {
    "palette": {
      "primary_accent": "#c8860d",
      "header_background": "#e8c580",
      "meta_background": "#f5e6c6",
      "tab_background": "#b8860b",
      "status_green": "#2e7d32",
      "status_orange": "#e07b00",
      "status_red": "#c62828",
      "status_neutral": "#333333",
      "text_color": "#333333",
      "border_color": "#d9a441",
      "page_background": "#ffffff"
    },
    "typography": {
      "font_family": "Arial, sans-serif",
      "base_font_size": 8,
      "table_font_size": 6.5,
      "title_font_size": 20,
      "section_title_font_size": 15
    }
  },
  "regions": {
    "top_banner": {
      "x": 0,
      "y": 0,
      "w": 1000,
      "h": 106,
      "title": null,
      "background": "#e8c580",
      "show_border": true,
      "padding": [
        8,
        14,
        8,
        14
      ],
      "gap": 6,
      "summary_left_x": 220
    },
    "left_column": {
      "x": 0,
      "y": 106,
      "w": 220,
      "h": 456.5,
      "title": "Project Details",
      "background": "#ffffff",
      "show_border": true,
      "padding": [
        8,
        10,
        8,
        10
      ],
      "distribute": true,
      "flex": true,
      "card_blank_lines": 2,
      "line_budget": 3,
      "top_pad_lines": 0.5,
      "gap": 6
    },
    "core_content": {
      "x": 220,
      "y": 106,
      "w": 780,
      "h": 456.5,
      "title": null,
      "background": "#ffffff",
      "show_border": true,
      "padding": [
        8,
        10,
        6,
        10
      ]
    }
  },
  "chrome": {
    "side_tab": {
      "enabled": true,
      "region": "left_column",
      "width": 24,
      "background": "#b8860b",
      "text_color": "#ffffff",
      "font_size": 12,
      "label": "PROJECT DOSSIER"
    },
    "borders": {
      "enabled": true,
      "color": "#d9a441",
      "stroke_width": 1
    },
    "section_titles": {
      "enabled": true,
      "font_size": 15,
      "font_color": "#c8860d",
      "font_weight": "bold",
      "offset_y": 12
    },
    "component_labels": {
      "enabled": true,
      "font_size": 11,
      "font_color": "#c8860d",
      "font_weight": "bold",
      "gap": 3
    },
    "top_banner_divider": {
      "enabled": true,
      "color": "#d9a441",
      "stroke_width": 1,
      "x_ratio": 0.212,
      "y_top": 4,
      "y_bottom": 102
    }
  },
  "routing": {
    "title": "top_banner",
    "formula-ref": "top_banner",
    "summary-block": "top_banner",
    "meta": "left_column",
    "info-card": "left_column",
    "efficacy-table": "core_content",
    "consumer-block": "core_content",
    "custom": "core_content",
    "efficacy-bar": "core_content",
    "consumer-bar": "core_content",
    "timeseries-line": "core_content",
    "region-bar": "core_content"
  },
  "stacking": {
    "default_gap": 8,
    "scale_to_fit": false,
    "max_pages": null
  },
  "pagination": {
    "overflow_region": "core_content",
    "repeat_regions": [
      "top_banner",
      "left_column"
    ],
    "continuation_label": "(continued)"
  }
}
